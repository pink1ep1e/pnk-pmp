# PostgreSQL (фаза 2+; фаза 1 UI работает на in-memory mock store)
DATABASE_URL="postgresql://pnk:PASSWORD@localhost:5432/pnk_pmp?schema=public"

# Сессия сотрудников PMP (обязательно в проде)
JWT_SECRET="REPLACE_WITH_openssl_rand_hex_32"

PORT=3200

# --- Admin API (loopback на той же VPS) ---
# Токены = ADMIN_API_TOKEN из .env pnk-id / pnk-mail
ID_ADMIN_URL=http://127.0.0.1:3100
ID_ADMIN_TOKEN=
MAIL_ADMIN_URL=http://127.0.0.1:3000
MAIL_ADMIN_TOKEN=

# Агент метрик → POST /api/vps/ingest
VPS_INGEST_SECRET=
